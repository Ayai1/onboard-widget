{
  "name": "@onboard/widget",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/onboard-widget.umd.cjs",
  "module": "./dist/onboard-widget.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/onboard-widget.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/onboard-widget.js",
      "require": "./dist/onboard-widget.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --config vite.config.ts && vite build --config vite.umd.config.ts --emptyOutDir false && node scripts/copy-umd.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.1"
  }
}

{
  "name": "onboard-widget",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @onboard/demo",
    "build": "npm run build --workspace @onboard/widget && npm run build --workspace @onboard/demo",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace @onboard/widget && npm run typecheck --workspace @onboard/demo",
    "test:widget": "npm run test --workspace @onboard/widget",
    "test:server": "python -m pytest server/tests",
    "test:e2e": "playwright test",
    "test:all": "npm run test:widget && npm run test:server && npm run test:e2e",
    "size:check": "node scripts/check-bundle-size.mjs",
    "server:dev": "python -m uvicorn server.app:app --reload --host 127.0.0.1 --port 8000",
    "server:seed": "python -m server.seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/node": "^24.10.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
